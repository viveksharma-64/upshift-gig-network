# ====================================================================
# UpShift Environment Configuration Example
# ====================================================================

# 1. Supabase Client (Browser & Frontend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 2. Server-Side Database Connection (Strictly Server-Side / Never VITE_)
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres

# 3. Server-Side LLM Providers (Strictly Server-Side / Never VITE_)
# Optional: UpShift runs on deterministic baseline rules if keys are omitted (₹0 budget).
LLM_PRIMARY_PROVIDER=groq           # 'groq' | 'gemini'
LLM_FALLBACK_PROVIDER=gemini        # 'gemini' | 'groq' | 'none'

# Google Gemini (Google AI Studio Free Tier)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-flash-lite-latest

# Groq (Groq Free Tier)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=qwen/qwen3.8-27b

# 4. Discovery Worker & Persistent Staging Configuration (Strictly Server-Side / Never VITE_)
DISCOVERY_DEFAULT_SOURCE=all       # 'all' | 'fixtures' | 'rss' | 'api'
DISCOVERY_BATCH_LIMIT=10
DISCOVERY_ENABLE_SECOND_PASS=true
CANDIDATE_STORAGE=supabase         # 'supabase' (persistent staging) | 'json' (local dev/test)

# Supabase Service-Role Key for Worker CLI (Strictly Server-Side / Never VITE_)
# Required for server-side worker to ingest into public.gig_candidates staging table
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 5. Daily Health Scheduler Daemon (Optional override in ms, defaults to 24 hours)
# DAILY_MONITOR_INTERVAL_MS=86400000



